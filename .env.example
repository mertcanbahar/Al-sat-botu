# Bu dosyayı .env olarak kopyalayıp doldurun. .env git'e GİRMEZ (.gitignore).
# Gerçek anahtarları asla bu dosyaya, koda, loga veya commit'e yazmayın.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
# Eski günlük sistemle aynı ad (notify.telegram / alsatbotu.config bunu okur)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
